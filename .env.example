# Copy to .env.local and fill in. Never commit .env.local.
#
# Setup instructions, in order, live in ADMIN_SETUP.md.


# ── The shop ─────────────────────────────────────────────────────────────

# The shop's WhatsApp number: country code + number, digits only.
# No "+", no spaces, no dashes — wa.me rejects anything else.
# Until this is set, every order button points at a placeholder that reaches
# nobody.
NEXT_PUBLIC_WHATSAPP_PHONE=919000000000

# Used for canonical URLs, the sitemap, OG tags, and the product link inside
# the WhatsApp message. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Database ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string → URI.
#
# Use the CONNECTION POOLER string (port 6543), not the direct one (5432).
# Serverless functions each open their own pool, and the direct connection
# runs out of slots under any real traffic.
#
# The password is the database password you set when creating the project —
# not any of the API keys below. If it contains a "#" or a "$", wrap the whole
# value in single quotes.
DATABASE_URL='postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres'


# ── Supabase ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API.

# Safe to expose. The browser needs it to talk to Auth and to read public
# storage objects.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. This key bypasses every row-level security policy in the
# project. It is read exclusively by modules that begin with `import
# "server-only"`, so importing it into a Client Component is a build error
# rather than a leak — but it must still never be given the NEXT_PUBLIC_
# prefix, and it must never be committed.
#
# Used for admin-side storage writes and for creating the first admin user.
SUPABASE_SERVICE_ROLE_KEY=


# ── Build ────────────────────────────────────────────────────────────────

# Optional. `next dev` and `next build` both write to .next, so a production
# build taken while the dev server is running corrupts it. Set this to send a
# build somewhere else:
#   BUILD_DIR=.next-prod npm run build
# BUILD_DIR=.next-prod
